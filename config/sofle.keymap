#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define NUMPAD 1
#define SYMBOL 2
#define NAV    3
#define ADJUST 4
#define MOUSE  5
#define EXCEL  6
#define AI     7

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        ht_numpad: ht_numpad {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            bindings = <&mo &tog>;
        };

        ht_nav: ht_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            bindings = <&mo &tog>;
        };
    };

    macros {
        excel_filter_legacy: excel_filter_legacy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp D>, <&macro_wait_time 80>, <&kp F &kp F>;
        };

        excel_freeze_panes: excel_freeze_panes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp W>, <&macro_wait_time 80>, <&kp F &kp F>;
        };

        excel_freeze_top: excel_freeze_top {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp W>, <&macro_wait_time 80>, <&kp F &kp R>;
        };

        excel_freeze_first: excel_freeze_first {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp W>, <&macro_wait_time 80>, <&kp F &kp C>;
        };

        excel_auto_col: excel_auto_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp H>, <&macro_wait_time 80>, <&kp O &kp I>;
        };

        excel_auto_row: excel_auto_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp H>, <&macro_wait_time 80>, <&kp O &kp A>;
        };

        excel_borders_all: excel_borders_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp H>, <&macro_wait_time 80>, <&kp B &kp A>;
        };

        excel_borders_none: excel_borders_none {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp H>, <&macro_wait_time 80>, <&kp B &kp N>;
        };

        excel_table: excel_table {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp A>, <&macro_wait_time 80>, <&kp T>;
        };

        excel_sort_asc: excel_sort_asc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp A>, <&macro_wait_time 80>, <&kp S &kp A>;
        };

        excel_sort_desc: excel_sort_desc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp A>, <&macro_wait_time 80>, <&kp S &kp D>;
        };

        excel_remove_dupes: excel_remove_dupes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp A>, <&macro_wait_time 80>, <&kp M>;
        };

        excel_gridlines: excel_gridlines {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp LALT>, <&macro_wait_time 180>, <&kp W>, <&macro_wait_time 80>, <&kp V &kp G>;
        };
    };

    combos {
        compatible = "zmk,combos";

        sym_combo {
            timeout-ms = <50>;
            key-positions = <55 52>;
            bindings = <&mo SYMBOL>;
        };

        adjust_combo {
            timeout-ms = <50>;
            key-positions = <54 55>;
            bindings = <&mo ADJUST>;
        };

        mouse_combo {
            timeout-ms = <50>;
            key-positions = <53 54>;
            bindings = <&tog MOUSE>;
        };

        excel_combo {
            timeout-ms = <50>;
            key-positions = <55 38>;
            bindings = <&tog EXCEL>;
        };

        ai_combo {
            timeout-ms = <50>;
            key-positions = <55 25>;
            bindings = <&tog AI>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESC         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                    &kp N6     &kp N7     &kp N8                &kp N9   &kp N0    &kp BACKSPACE
&kp TAB         &kp Q         &kp W         &kp E         &kp R         &kp T                                     &kp Y      &kp U      &kp I                 &kp O    &kp P     &kp EQUAL
&kp LEFT_SHIFT  &kp A         &kp S         &kp D         &kp F         &kp G                                     &kp H      &kp J      &kp K                 &kp L    &kp SEMI  &kp LEFT_BRACKET
&kp LCTRL       &kp Z         &kp X         &kp C         &kp V         &kp B      &kp PSCRN         &kp C_MUTE        &kp N      &kp M      &kp COMMA             &kp DOT  &kp FSLH  &kp RIGHT_BRACKET
                              &kp LGUI      &kp LALT      &kp DELETE    &kp SPACE  &ht_numpad 1 1    &ht_nav 3 3  &kp SPACE  &kp ENTER  &kp NON_US_BACKSLASH  &kp SQT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        numpad_layer {
            display-name = "NUM";


            bindings = <
&kp GRAVE  &kp F1     &kp F2     &kp F3    &kp F4    &kp F5                       &kp F6     &kp F7      &kp F8        &kp F9           &kp F10   &kp F11
&kp TILDE  &kp N1     &kp N2     &kp N3    &kp N4    &kp N5                       &kp KP_N7  &kp KP_N8   &kp KP_N9     &kp KP_DIVIDE    &kp N0    &kp F12
&trans     &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                    &kp KP_N4  &kp KP_N5   &kp KP_N6     &kp KP_MULTIPLY  &kp RPAR  &kp PIPE
&trans     &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &to BASE     &trans  &kp KP_N1  &kp KP_N2   &kp KP_N3     &kp KP_MINUS     &kp BSLH  &trans
                      &trans     &trans    &trans    &trans     &trans    &trans  &kp KP_N0  &kp KP_DOT  &kp KP_ENTER  &kp KP_PLUS
            >;

        };

        symbol_layer {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &trans     &trans     &trans    &trans    &trans                         &trans              &trans             &trans    &trans    &trans    &kp MINUS
&kp TILDE  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                      &kp CARET           &kp AMPS           &kp STAR  &kp LPAR  &kp RPAR  &kp PIPE
&trans     &kp MINUS  &kp EQUAL  &kp PLUS  &kp UNDER &kp PIPE                       &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp LBRC  &kp RBRC  &kp COLON &kp BSLH
&trans     &kp GRAVE  &kp TILDE  &kp BSLH  &kp FSLH  &kp QMARK  &trans     &trans  &kp LT             &kp GT             &kp SQT   &kp DQT   &kp SEMI  &trans
                      &trans     &trans    &trans    &trans     &trans      &trans  &trans             &trans             &trans     &trans
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4              &trans    &trans     &trans    &trans     &trans   &trans
&trans  &trans        &trans        &trans        &trans        &trans                    &kp HOME  &kp PG_UP  &kp UP    &kp PG_DN  &kp END  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &kp INS   &kp LEFT   &kp DOWN  &kp RIGHT  &kp DEL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &to BASE    &trans  &trans    &trans     &trans    &trans     &trans   &trans
                &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans     &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LS(LA(TAB)) LA(TAB)>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "ADJ";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &rgb_ug RGB_COLOR_HSB(0,100,1)    &rgb_ug RGB_COLOR_HSB(30,100,1)  &rgb_ug RGB_COLOR_HSB(60,100,1)  &rgb_ug RGB_COLOR_HSB(120,100,1)  &rgb_ug RGB_COLOR_HSB(180,100,1)  &rgb_ug RGB_COLOR_HSB(250,100,1)
&ext_power EP_TOG  &soft_off        &bootloader      &sys_reset       &none            &none                            &to BASE                          &rgb_ug RGB_OFF                  &rgb_ug RGB_ON                  &rgb_ug RGB_COLOR_HSB(32,90,3)    &rgb_ug RGB_COLOR_HSB(185,70,4)   &rgb_ug RGB_COLOR_HSB(285,80,5)
&rgb_ug RGB_TOG    &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI                  &none                             &rgb_ug RGB_COLOR_HSB(0,80,8)    &rgb_ug RGB_COLOR_HSB(45,90,8)   &rgb_ug RGB_COLOR_HSB(145,70,8)   &rgb_ug RGB_COLOR_HSB(215,80,8)   &rgb_ug RGB_COLOR_HSB(300,70,8)
&none              &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &to 0    &none  &none                             &none                            &none                            &none                             &none                             &none
                                    &none            &none            &none            &none            &to BASE &to BASE &none                            &none                            &none                            &none
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&kp ESC     &none           &none           &none           &none           &kp TAB                      &none           &none           &msc SCRL_UP    &none            &mkp MB4    &mkp MB5
&kp LCTRL   &kp LEFT_SHIFT  &kp SPACE       &kp ENTER       &kp BACKSPACE   &kp DELETE                   &none           &none           &mmv MOVE_UP    &none            &none       &none
&kp LALT    &kp LGUI        &kp TAB         &kp ENTER       &kp SPACE       &kp BACKSPACE                &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &none
&none       &kp LC(Z)       &kp LC(X)       &kp LC(C)       &kp LC(V)       &none        &to BASE  &none   &none           &none           &msc SCRL_DOWN  &none            &none            &none
                            &kp LGUI        &kp LALT        &kp DELETE      &kp SPACE    &to BASE  &to BASE &kp SPACE       &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        excel_layer {
            display-name = "EXCEL";
            bindings = <
&to BASE       &kp F2          &kp F4          &kp LA(EQUAL)     &kp LC(SEMI)      &kp LC(LS(SEMI))              &excel_filter_legacy  &kp LC(LS(L))       &excel_table       &excel_sort_asc    &excel_sort_desc   &excel_remove_dupes
&kp LC(HOME)   &kp LC(PG_UP)   &kp LC(UP)      &kp LC(PG_DN)     &kp LC(END)       &kp LC(GRAVE)                 &excel_freeze_panes   &excel_freeze_top   &excel_freeze_first &excel_gridlines   &excel_auto_col    &excel_auto_row
&kp LS(SPACE)  &kp LC(SPACE)   &kp LC(MINUS)   &kp LC(LS(EQUAL)) &excel_borders_all &excel_borders_none           &kp LC(LS(LEFT))      &kp LC(LS(DOWN))    &kp LC(LS(UP))    &kp LC(LS(RIGHT))  &kp LC(B)          &kp LC(U)
&kp ESC        &kp LC(Z)       &kp LC(X)       &kp LC(C)         &kp LC(V)         &kp LC(B)      &to BASE  &trans  &kp LC(LEFT)        &kp LC(DOWN)       &kp LC(UP)        &kp LC(RIGHT)      &kp LC(I)          &trans
                              &kp LGUI        &kp LALT          &kp DELETE        &kp SPACE       &to BASE  &to BASE &kp SPACE           &kp ENTER          &kp TAB           &kp F2
            >;
        };

        ai_layer {
            display-name = "AI";
            bindings = <
&kp ESC    &kp LC(C)       &kp LC(L)       &kp LC(R)      &kp LC(U)      &kp LC(W)                 &kp LC(TAB)    &kp LC(LS(TAB))  &kp PG_UP       &kp LS(PG_UP)    &msc SCRL_UP      &to BASE
&kp TAB    &kp LC(A)       &kp LA(B)       &kp LA(F)      &kp LC(E)      &kp LA(BACKSPACE)         &kp HOME       &kp PG_UP        &kp UP          &kp PG_DN        &kp END          &kp DEL
&trans     &kp LC(LS(C))   &kp LC(LS(V))   &kp LC(Z)      &kp LC(Y)      &kp LC(D)                 &kp INS        &kp LEFT         &kp DOWN        &kp RIGHT        &kp BACKSPACE    &kp ENTER
&kp LCTRL  &kp LC(Z)       &kp LC(X)       &kp LC(C)      &kp LC(V)      &kp LC(B)  &to BASE  &trans  &kp LC(LEFT)  &kp LS(PG_DN)  &kp LS(PG_UP)  &kp LC(RIGHT)  &kp LC(LS(C))  &kp LC(LS(V))
                          &kp LGUI        &kp LALT       &kp DELETE     &kp LS(ENTER) &to BASE  &to BASE &kp SPACE    &kp ENTER      &kp TAB        &kp ESC
            >;
        };
    };
};
